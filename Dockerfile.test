# 使用官方 alpine
FROM alpine:latest AS builder

# 根据你的项目代码，补齐 curl 和 jansson 的静态开发包
RUN apk add --no-cache \
    build-base \
    libev-dev \
    curl-dev \
    curl-static \
    jansson-dev \
    pcre2-dev \
    git \
    file \
    bash \
    dos2unix \
    zlib-static \
    openssl-libs-static \
    nghttp2-static

WORKDIR /app
COPY . .

# 处理换行符并生成版本
RUN find scripts/ -type f -exec dos2unix {} + && \
    chmod +x scripts/gen_version.sh && \
    ./scripts/gen_version.sh

# 严格执行你提供的编译逻辑
RUN make clean && make -j$(nproc) \
    EXTRA_CFLAGS="-I/usr/include" \
    EXTRA_LDFLAGS="-L/usr/lib -lev -lcurl -ljansson -lpthread -static"

# 运行并捕获版本
RUN ./build/bin/atpd -v > /app/runtime_version.txt
RUN file build/bin/atpd > /app/static_check.txt

# 最终导出阶段
FROM scratch
COPY --from=builder /app/build/bin/atpd /atpd
COPY --from=builder /app/runtime_version.txt /runtime_version.txt
COPY --from=builder /app/static_check.txt /static_check.txt

