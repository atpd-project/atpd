# =============================================================================
# ATP (Advanced Transparent Proxy) Configuration File - Pure eBPF Edition
# Location: <MODULE_DIR>/atp.conf (Auto-detected from /proc/self/exe parent directory)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Directory & Path Configuration (Self-Adaptive / Zero-Config by default)
# -----------------------------------------------------------------------------

# Working root directory containing atpd, atp.conf, config.json, and bin/
# Default: dynamically resolved from binary location (e.g. /data/adb/atp)
# DATA_DIR="/data/adb/atp"

# Runtime transient directory (stores PID files, UDS sockets, logs, state)
# Default: "run" (resolves to <DATA_DIR>/run)
# RUN_DIR="run"

# Optional fine-grained path overrides
# PID_FILE="run/atpd.pid"
# LOG_FILE="run/atp.log"

# -----------------------------------------------------------------------------
# 2. Core & Supervisor Settings
# -----------------------------------------------------------------------------

# Process user and group for child supervision
# Android default: "root:net_admin" (AID_NET_ADMIN=3005 for network socket capabilities)
# Linux default:   "root:root"
CORE_USER_GROUP="root:net_admin"

# Restart delay in seconds after abnormal child exit
RESTART_DELAY=2

# Include timestamp in log outputs: 1=yes, 0=no
LOG_TIMESTAMP=1

# UI Emoji symbols in CLI output: 1=enable, 0=disable
UI_EMOJI_ENABLED=1

# -----------------------------------------------------------------------------
# 3. External API Configuration (Clash REST API)
# Note: Automatically auto-synced from config.json if experimental.clash_api exists
# -----------------------------------------------------------------------------

# API host and port (default: 127.0.0.1:9090)
API_HOST="127.0.0.1"
API_PORT=9090

# API secret (leave empty if not configured in sing-box)
CLASH_SECRET=""

# -----------------------------------------------------------------------------
# 4. Service Supervisor & Circuit Breaker Parameters
# -----------------------------------------------------------------------------

# Service start timeout in seconds
SERVICE_START_TIMEOUT=30

# Service stop timeout in seconds
SERVICE_STOP_TIMEOUT=10

# Grace period in seconds before SIGKILL on shutdown
SERVICE_GRACE_PERIOD=5

# Maximum consecutive failures before circuit breaker opens
SERVICE_MAX_FAILURES=5

# Failure count threshold within sliding window to trip circuit breaker
SERVICE_CIRCUIT_THRESHOLD=3

# Circuit breaker cooldown in seconds
SERVICE_CIRCUIT_COOLDOWN=60

# Background proxy health check interval in milliseconds (default: 5000)
SERVICE_HEALTH_CHECK_INTERVAL=5000

# Optional custom arguments for sing-box execution
# SERVICE_ARGS=""

# Optional custom environment variables (space-separated KEY=VALUE pairs)
# SERVICE_ENV=""
