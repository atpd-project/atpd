# ATP (Advanced Transparent Proxy) Configuration File - Pure eBPF Edition
# Location: /data/adb/atp/atp.conf

# -----------------------------------------------------------------------------
# Core & Supervisor Settings
# -----------------------------------------------------------------------------

# Performance mode: 1=on (TCP BBR & Kernel Scheduler optimization)
PERFORMANCE_MODE=1

# Include timestamp in logs: 1=yes, 0=no
LOG_TIMESTAMP=1

# Process user and group for child supervision
CORE_USER_GROUP="root:net_admin"

# Restart delay in seconds after abnormal service exit
RESTART_DELAY=2

# -----------------------------------------------------------------------------
# eBPF & Inbound Configuration
# -----------------------------------------------------------------------------

# Enable kernel eBPF engine (cgroup socket interception)
ENABLE_EBPF=1

# IPv6 proxy support: 1=enable, 0=disable
PROXY_IPV6=1

# DNS hijacking via eBPF: 1=enable, 0=disable
DNS_HIJACK_ENABLE=1

# -----------------------------------------------------------------------------
# External API Configuration (sing-box / Clash REST API)
# -----------------------------------------------------------------------------

# API host and port (default: 127.0.0.1:9090)
API_HOST="127.0.0.1"
API_PORT=9090

# API secret (leave empty if not configured in sing-box)
CLASH_SECRET=""

# -----------------------------------------------------------------------------
# Service Supervisor Parameters
# -----------------------------------------------------------------------------

# Service start timeout in seconds
SERVICE_START_TIMEOUT=30

# Service stop timeout in seconds
SERVICE_STOP_TIMEOUT=10

# Maximum consecutive failures before circuit breaker opens
SERVICE_MAX_FAILURES=5

# Circuit breaker cooldown in seconds
SERVICE_CIRCUIT_COOLDOWN=60

# Optional custom arguments for sing-box
# SERVICE_ARGS="run -c /data/adb/atp/sing-box/config.json"
