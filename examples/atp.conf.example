# ATPd eBPF configuration

ATP_DATA="/data/adb/atp"
NETWORK_BACKEND="ebpf"
CORE_USER_GROUP="root:net_admin"

# Empty uses Android hotspot interface discovery.
HOTSPOT_INTERFACE=""

# Clash API and automatic mode selection.
API_HOST="127.0.0.1"
API_PORT=9090
CLASH_SECRET=""
USER_CLASH_MODE="Rule"

# Switch to Direct on this Wi-Fi SSID, then restore the selected mode.
# Empty disables the override.
DIRECT_WIFI_SSID=""

# sing-box service supervision.
SERVICE_START_TIMEOUT=10
SERVICE_STOP_TIMEOUT=10
SERVICE_GRACE_PERIOD=3
SERVICE_MAX_FAILURES=5
SERVICE_CIRCUIT_THRESHOLD=5
SERVICE_CIRCUIT_COOLDOWN=300
SERVICE_HEALTH_CHECK_INTERVAL=5000
SERVICE_ARGS=""
SERVICE_ENV=""

DRY_RUN=0
