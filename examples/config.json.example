{
  log: {
    level: info,
    timestamp: true
  },
  services: [
    {
      type: api,
      tag: api-service,
      listen: 127.0.0.1,
      listen_port: 9080
    }
  ],
  experimental: {
    # Enables the optional Clash-mode RPCs used for Google VPN handover.
    # Add a route rule with clash_mode: Google VPN to make that mode valid.
    clash_api: {}
  },
  inbounds: [
    {
      type: ebpf,
      tag: ebpf-in,
      auto_redirect: true,
      cgroup_path: /sys/fs/cgroup,
      include_package: [],
      exclude_package: [
        com.google.android.gms,
        com.android.vending
      ]
    }
  ],
  outbounds: [
    {
      type: selector,
      tag: select,
      outbounds: [
        proxy,
        direct
      ],
      default: proxy
    },
    {
      type: direct,
      tag: direct
    },
    {
      type: block,
      tag: block
    },
    {
      type: dns,
      tag: dns-out
    }
  ],
  route: {
    rules: [
      {
        protocol: dns,
        outbound: dns-out
      },
      {
        ip_is_private: true,
        outbound: direct
      },
      {
        clash_mode: Google VPN,
        outbound: direct
      },
      {
        clash_mode: Global,
        outbound: select
      },
      {
        clash_mode: Direct,
        outbound: direct
      }
    ],
    auto_detect_interface: true
  }
}
